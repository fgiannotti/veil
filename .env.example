DATABASE_URL=postgres://bench:bench@localhost:5432/bench

AUTH_SECRET=change-me-to-a-long-random-string
AUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect URI (local): http://localhost:3000/api/auth/callback/google
# Leave empty to disable Google sign-in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Local dev: MailHog (docker compose up mail)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bench <no-reply@bench.com.ar>"

# Production (Resend SMTP — set on host, not in git):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key
# SMTP_FROM="Bench <no-reply@bench.com.ar>"

INDICATORS_REFRESH_TOKEN=change-me-cron-token

# Comma-free single admin email for /admin/reviews (optional)
ADMIN_EMAIL=

USD_BLUE_API_URL=https://api.bluelytics.com.ar/v2/latest
